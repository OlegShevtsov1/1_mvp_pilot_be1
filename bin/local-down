#!/usr/bin/env bash
# Stops the server bin/local-up started. Exits 0 whether or not one was running.
# PROJECTS_TASKS_API_STATE_DIR relocates the state dir, as for bin/local-up.
set -euo pipefail

PID_FILE=${PROJECTS_TASKS_API_STATE_DIR:-${HOME}/.local/state/projects-tasks-api}/gunicorn.pid

if [ -f "$PID_FILE" ]; then
  pid=$(cat "$PID_FILE")
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    kill -TERM "$pid"
    for _ in $(seq 15); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 1
    done
    if kill -0 "$pid" 2>/dev/null; then
      kill -KILL "$pid"
    fi
  fi
  rm -f "$PID_FILE"
fi
