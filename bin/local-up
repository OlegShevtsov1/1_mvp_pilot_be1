#!/usr/bin/env bash
# Runs a commit of this repository locally: clones origin into a run dir under the state dir,
# checks out --ref (default origin/main), migrates and (re)starts gunicorn on 127.0.0.1:8095.
# PROJECTS_TASKS_API_STATE_DIR relocates the state dir (default ~/.local/state/projects-tasks-api).
# Usage: bin/local-up [--ref <rev>]
set -euo pipefail

usage() {
  echo "usage: bin/local-up [--ref <rev>]" >&2
  exit 2
}

ref=origin/main
if [ $# -eq 2 ] && [ "$1" = --ref ] && [ -n "$2" ]; then
  ref=$2
elif [ $# -ne 0 ]; then
  usage
fi

for tool in uv git curl; do
  command -v "$tool" >/dev/null || { echo "local-up: $tool is not on PATH" >&2; exit 1; }
done

BIN=$(cd "$(dirname "$0")" && pwd)
STATE=${PROJECTS_TASKS_API_STATE_DIR:-${HOME}/.local/state/projects-tasks-api}
APP=$STATE/app
PORT=8095

mkdir -p "$STATE"
if [ ! -d "$APP/.git" ]; then
  git clone --quiet "$(git -C "$BIN/.." remote get-url origin)" "$APP"
fi
git -C "$APP" fetch --quiet origin
git -C "$APP" checkout --quiet --force --detach "$ref"
release=$(git -C "$APP" rev-parse HEAD)

cd "$APP"
uv sync --frozen --no-dev --quiet

# The database lives outside the checkout so it survives ref switches.
export DJANGO_SETTINGS_MODULE=config.settings.local
export DATABASE_URL=sqlite:///$STATE/db.sqlite3
export APP_RELEASE=$release

uv run --no-sync python manage.py migrate --noinput
"$BIN/local-down"
uv run --no-sync gunicorn config.wsgi:application \
  --chdir "$APP" \
  --bind "127.0.0.1:$PORT" \
  --workers 2 \
  --daemon \
  --pid "$STATE/gunicorn.pid" \
  --error-logfile "$STATE/gunicorn.log" \
  --access-logfile "$STATE/access.log"

# Waits for /health to report this release, so a stale server still holding the port
# (a lost pid file, an untracked process) is not taken for the new one.
for _ in $(seq 30); do
  body=$(curl -fsS --max-time 5 "http://127.0.0.1:$PORT/health" 2>/dev/null) || body=
  if [[ $body == *"\"release\": \"$release\""* ]]; then
    echo "projects-tasks-api up at http://127.0.0.1:$PORT (release $release)"
    exit 0
  fi
  sleep 1
done
echo "local-up: /health did not report release $release within 30 s; last lines of $STATE/gunicorn.log:" >&2
tail -n 50 "$STATE/gunicorn.log" >&2 || true
exit 1
